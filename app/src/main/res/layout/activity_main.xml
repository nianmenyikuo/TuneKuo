<?xml version="1.0" encoding="utf-8"?>
<com.personal.tunebox.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSwipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tk_surface">

    <LinearLayout
        android:id="@+id/pageMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/tk_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="10dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/library_title"
                android:textColor="@color/tk_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/scanning"
                android:textColor="@color/tk_on_surface_variant"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRescan"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/rescan"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/tk_on_surface_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/settings"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/tk_on_surface_variant" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchBox"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:hint="@string/search_hint"
            app:boxBackgroundColor="@color/tk_surface_highest"
            app:boxCornerRadiusBottomEnd="24dp"
            app:boxCornerRadiusBottomStart="24dp"
            app:boxCornerRadiusTopEnd="24dp"
            app:boxCornerRadiusTopStart="24dp"
            app:boxStrokeColor="@color/tk_outline"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="@color/tk_on_surface_variant"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/tk_on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/tk_on_surface"
                android:textColorHint="@color/tk_dim"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSongs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/scanBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/tk_scan_scrim"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingEnd="44dp"
                android:visibility="gone">

                <com.personal.tunebox.ScanIndicatorView
                    android:id="@+id/scanAnim"
                    android:layout_width="68dp"
                    android:layout_height="68dp" />

                <TextView
                    android:id="@+id/tvScanTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/tk_on_surface_variant"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/tk_surface_container"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:contentPadding="14dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivNowCover"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/not_playing"
                        android:src="@drawable/ic_default_cover"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.TuneKuo.Cover" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/not_playing"
                            android:textColor="@color/tk_on_surface"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvNowInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text=""
                            android:textColor="@color/tk_on_surface_variant"
                            android:textSize="12sp"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNow"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/now_title"
                        app:icon="@drawable/ic_waveform"
                        app:iconTint="@color/tk_on_surface_variant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLyrics"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/no_lyrics"
                        app:icon="@drawable/ic_expand"
                        app:iconTint="@color/tk_on_surface_variant" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="@color/tk_on_surface_variant"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mode_repeat_list"
                        android:textColor="@color/tk_on_surface_variant"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="2dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrev"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/notif_prev"
                        app:icon="@drawable/ic_prev"
                        app:iconTint="@color/tk_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlay"
                        style="@style/Widget.Material3.Button.IconButton.Filled"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="28dp"
                        android:layout_marginEnd="28dp"
                        android:contentDescription="@string/notif_play_pause"
                        app:cornerRadius="32dp"
                        app:icon="@drawable/ic_play"
                        app:iconSize="30dp"
                        app:iconTint="@color/tk_on_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNext"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/notif_next"
                        app:icon="@drawable/ic_next"
                        app:iconTint="@color/tk_on_surface" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMode"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/mode_repeat_list"
                    android:textColor="@color/tk_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ScrollView
        android:id="@+id/pageSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tk_surface"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:text="@string/back"
                android:textColor="@color/tk_secondary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings"
                android:textColor="@color/tk_on_surface"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/settings_language"
                android:textColor="@color/tk_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/optZh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_item"
                android:foreground="?attr/selectableItemBackground"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/lang_zh"
                android:textColor="@color/tk_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/optEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_item"
                android:foreground="?attr/selectableItemBackground"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/lang_en"
                android:textColor="@color/tk_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/optJa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_item"
                android:foreground="?attr/selectableItemBackground"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="@string/lang_ja"
                android:textColor="@color/tk_secondary"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFeedback"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:minWidth="0dp"
                android:text="@string/settings_feedback"
                android:textColor="@color/tk_primary" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text=""
                android:textColor="@color/tk_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/pageNow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tk_now_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNowBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="@string/back"
                android:textColor="@color/tk_secondary" />

            <TextView
                android:id="@+id/tvNowHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/now_title"
                android:textColor="@color/tk_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBigTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/not_playing"
                android:textColor="@color/tk_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBigArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/tk_on_surface_variant"
                android:textSize="13sp" />

            <com.personal.tunebox.WaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="28dp" />

            <TextView
                android:id="@+id/tvBigTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="0:00"
                android:textColor="@color/tk_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNowPrev"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/notif_prev"
                app:icon="@drawable/ic_prev"
                app:iconTint="@color/tk_on_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNowPlay"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:contentDescription="@string/notif_play_pause"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_play"
                app:iconSize="30dp"
                app:iconTint="@color/tk_on_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNowNext"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/notif_next"
                app:icon="@drawable/ic_next"
                app:iconTint="@color/tk_on_surface" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNowMode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="@string/mode_repeat_list"
            android:textColor="@color/tk_primary" />
    </LinearLayout>
</com.personal.tunebox.SwipeLayout>
